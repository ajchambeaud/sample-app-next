# Copy to .env.local for local development outside Docker.
DATABASE_URL=file:./data/library.sqlite
SESSION_SECRET=dev-secret-change-me
# Set to "true" when serving over HTTPS so the session cookie is marked Secure.
SESSION_COOKIE_SECURE=false

# Object storage (MinIO in docker compose). The internal endpoint is used for
# server-side calls; the public one is baked into the presigned URLs the
# browser hits, so it must be reachable from the browser.
S3_ENDPOINT=http://localhost:4902
S3_PUBLIC_ENDPOINT=http://localhost:4902
S3_REGION=us-east-1
S3_BUCKET=covers
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
PRESIGN_PUT_TTL=300
PRESIGN_GET_TTL=600

# Faustine Web Agent. The identity secret (portal → Settings → Identity
# verification) signs the signed-in user's identity for the assistant; leave it
# empty and visitors are anonymous. The public env is only needed when this
# deployment maps to a non-Production environment of the Web Agent.
FAUSTINE_IDENTITY_SECRET=
# "true" opens a debug session for the portal's Tests tab. Dev/staging only.
FAUSTINE_DEBUG=false
NEXT_PUBLIC_FAUSTINE_ENV=
